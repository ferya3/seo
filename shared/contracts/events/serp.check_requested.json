{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seo.platform/contracts/events/serp.check_requested.json",
  "title": "serp.check_requested",
  "description": "A rank check has been asked for. Published by the gateway or the orchestrator; consumed by the SERP service.",
  "type": "object",
  "required": ["check_id", "target_domain", "keywords"],
  "additionalProperties": false,
  "properties": {
    "check_id": {"type": "string", "format": "uuid"},
    "target_domain": {"type": "string", "maxLength": 253},
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "provider": {"type": "string", "maxLength": 40},
    "lang": {"type": "string", "maxLength": 10},
    "country": {"type": "string", "maxLength": 5}
  }
}
